  m_Script: {fileID: 11500000, guid: a5d99d28dd25fef4a93b1fa25332afa8, type: 3}
  m_Name: Mail_Welcome
  m_EditorClassIdentifier: 
  mailType: 0
  title: "WELCOME TO MINING OPERATIONS"
  message: "Dear Partner,\n\nOn behalf of the Corporation, we are pleased to welcome you to our mining operations in this strategic sector. This marks the beginning of what we anticipate to be a long-term and prosperous partnership.\n\nCurrently, you are operating as an independent contractor. To advance and gain access to corporate protection and high-value contracts, please accumulate resources and visit the Licensing System (Key B) to upgrade your legal status.\n\nWe wish you a productive and successful start.\n\nRegards,\nDepartment of Mining Operations."
