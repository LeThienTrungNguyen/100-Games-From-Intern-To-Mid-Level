  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e98c16f30cdd16145af7e24da3710854, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  outroContainer: {fileID: 1541712942}
  txtNarrative: {fileID: 1302968188}
  finalChoicePanel: {fileID: 1208775194}
  txtFinalQuestion: {fileID: 1208775196}
  btnYes: {fileID: 424763241}
  btnNo: {fileID: 214501998}
  textDisplayDuration: 4
  fadeDuration: 1.5
  outroTexts:
  - Phew... finally, it's over. That cursed mine and those devilish KPIs nearly drained
    every bit of my strength.
  - But I made it through. It's incredible what someone pushed to the edge is capable
    of doing.
  - "Whatever... the point is, I conquered it. I'm exhausted, but I've earned a decent
    amount\u2014enough to live comfortably for a long time."
  - I wonder... should I actually stick with this line of work?
  - Thank you for completing this demo. If you enjoyed the experience, please consider
    leaving some feedback. I truly appreciate your time.
